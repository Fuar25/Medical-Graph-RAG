# LLM - GPT proxy (highest priority when GPT_API_KEY is set)
GPT_API_KEY=your-gpt-api-key
GPT_API_BASE_URL=https://your-proxy.example.com/v1
GPT_CHAT_MODEL=gpt-5.5

# LLM - GLM fallback (used when GPT_API_KEY is absent)
GLM_API_KEY=your-glm-api-key
GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_CHAT_MODEL=glm-5.1

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Local Docker Neo4j password used by docker-compose.yml
NEO4J_LOCAL_PASSWORD=your-local-neo4j-password
